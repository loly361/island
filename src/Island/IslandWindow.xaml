<Window x:Class="Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Island.Services"
        xmlns:local="clr-namespace:Island"
        Title="Island" Width="660" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Surface" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="Surface2" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="Hairline" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="TimerBrush" Color="#FF9F0A"/>
        <!-- Icon buttons take an icon name as content (e.g. Content="trash"); the selector draws it with local:Icon. -->
        <local:IconContentSelector x:Key="IconContent"/>
        <!-- Concentric radii: the panel is 34, cards inset by 14 get 22, rows and tiles inside cards get 14. -->
        <CornerRadius x:Key="CardRadius">22</CornerRadius>
        <CornerRadius x:Key="RowRadius">14</CornerRadius>

        <!-- 3D icons: each icon is lit from above (light top, darker bottom) and casts a soft shadow underneath. -->
        <LinearGradientBrush x:Key="IconFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.35"/>
            <GradientStop Color="#6F82A0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IconLit" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.2"/>
            <GradientStop Color="#C9D6EA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IconDim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6EDF7" Offset="0.35"/>
            <GradientStop Color="#3F4D63" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IconFaint" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#70FFFFFF" Offset="0.4"/>
            <GradientStop Color="#2A9FB2C9" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="IconShadow" Direction="90" ShadowDepth="2" BlurRadius="1.5" Opacity="0.85" Color="#000000"/>
        <DropShadowEffect x:Key="IconBadgeShadow" Direction="90" ShadowDepth="2" BlurRadius="6" Opacity="0.4" Color="#000000"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Shown over an empty list: a large faint icon and one line of text. -->
        <Style x:Key="EmptyGlyph" TargetType="local:Icon">
            <Setter Property="Size" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource IconFaint}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Glyph" TargetType="local:Icon">
            <Setter Property="Size" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource IconFill}"/>
            <Setter Property="Effect" Value="{StaticResource IconShadow}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource IconDim}"/>
            <Setter Property="Effect" Value="{StaticResource IconShadow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource IconContent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource IconLit}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.07"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{StaticResource IconDim}"/>
            <Setter Property="Effect" Value="{StaticResource IconShadow}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource IconContent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource IconLit}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource IconLit}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18" Padding="4,6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlTile" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,10" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ContentTemplateSelector" Value="{StaticResource IconContent}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#0B0B0D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="White" CornerRadius="21" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E4E4EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.07"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="1"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource TimerBrush}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFB340"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FmtBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{StaticResource Surface}" CornerRadius="20" Padding="14,0" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:Icon Style="{StaticResource Glyph}" Kind="magnifyingglass" Size="14" Foreground="{StaticResource SubBrush}" Margin="0,0,10,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource SubBrush}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{StaticResource Surface2}" CornerRadius="16" Padding="12,0" Height="32">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource SubBrush}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeatInvisible" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeatFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RepeatFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RepeatInvisible}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Each row is its own small card; the container owns hover and keyboard selection so rows stay plain. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Surface}" CornerRadius="{StaticResource RowRadius}" Margin="0,0,0,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Surface2}" CornerRadius="14" Margin="0,0,6,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem}"/>
        </Style>

        <Style x:Key="CardList" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
        </Style>

        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipRowTemplate">
            <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource RowRadius}" Padding="10,8" Cursor="Hand"
                    MouseLeftButtonUp="ClipRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource Surface2}">
                        <local:Icon Style="{StaticResource Glyph}" Kind="doc" Size="14" Foreground="{StaticResource SubBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource SubBrush}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding PinGlyph}" Foreground="{Binding PinBrush}" Width="28" Height="28" Click="ClipPin_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="trash" Width="28" Height="28" Click="ClipDelete_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SearchRowTemplate">
            <Border Background="Transparent" CornerRadius="{StaticResource RowRadius}" Padding="12,10" Cursor="Hand" MouseLeftButtonUp="SearchRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:Icon Style="{StaticResource Glyph}" Kind="{Binding Glyph}" Size="15" Foreground="{StaticResource SubBrush}" Width="22"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Subtitle}" Foreground="{StaticResource SubBrush}" FontSize="11" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NoteRowTemplate">
            <Border Padding="12,5">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReminderRowTemplate">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DueLabel}" Foreground="{StaticResource TimerBrush}" FontSize="10"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="xmark" Width="24" Height="24" FontSize="10" Click="ReminderDelete_Click"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InboxRowTemplate">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" VerticalAlignment="Top">
                    <Border CornerRadius="11" Background="{DynamicResource AccentBrush}" Opacity="0.22"/>
                    <local:Icon Style="{StaticResource Glyph}" Kind="bell" Size="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Body}" Foreground="{StaticResource SubBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                    <TextBlock Text="{Binding Meta}" Foreground="#59FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- The pill is always laid out at its largest size; a clip shows the current shape. Resizing a clip costs no layout pass. -->
    <Border x:Name="Pill" Width="600" Height="395" HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="{StaticResource Bg}" ClipToBounds="True">
        <Border.Clip>
            <RectangleGeometry x:Name="PillClip" Rect="205,-40,190,74" RadiusX="18" RadiusY="18"/>
        </Border.Clip>
        <Grid>
            <!-- Minimal mode: the resting circle shows a single accent dot -->
            <Ellipse x:Name="MinimalDot" Width="6" Height="6" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"/>

            <!-- Collapsed: clock and weather -->
            <StackPanel x:Name="CollapsedView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Height="34">
                <ContentControl x:Name="WeatherIconHost" Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock x:Name="TimeText" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TempText" Foreground="{StaticResource SubBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <local:Icon x:Name="PlayingDot" Style="{StaticResource Glyph}" Kind="music.note" Size="12" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" Visibility="Collapsed"/>
                <Border x:Name="CoverChip" Width="18" Height="18" CornerRadius="5" Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource Surface2}" ClipToBounds="True" Visibility="Collapsed"/>
                <StackPanel x:Name="TimerChip" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="2.2" Margin="1"/>
                        <Path x:Name="MiniRingArc" Stroke="{StaticResource TimerBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="TimerChipText" Foreground="{StaticResource TimerBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Alert: notifications, reminders and tool results -->
            <Grid x:Name="AlertView" Width="390" Height="62" Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AlertIcon" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <local:Icon x:Name="AlertGlyph" Style="{StaticResource Glyph}" Kind="exclamationmark.triangle" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AlertTitle" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlertMessage" Foreground="{StaticResource SubBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Expanded panel -->
            <Grid x:Name="ExpandedView" VerticalAlignment="Top" Height="345" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><ScaleTransform x:Name="ExpandedScale"/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,6,14,0">
                    <Border x:Name="TabIndicator" Width="38" Height="32" CornerRadius="16" HorizontalAlignment="Left"
                            Background="{StaticResource Surface2}" IsHitTestVisible="False">
                        <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorShift"/></Border.RenderTransform>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="TabHome" Style="{StaticResource TabBtn}" Content="house" Tag="0" ToolTip="{loc:T 'Главная'}" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabClip" Style="{StaticResource TabBtn}" Content="clipboard" Tag="1" ToolTip="{loc:T 'Буфер обмена'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabInbox" Style="{StaticResource TabBtn}" Content="bell" Tag="2" ToolTip="{loc:T 'Уведомления'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabNotes" Style="{StaticResource TabBtn}" Content="square.and.pencil" Tag="3" ToolTip="{loc:T 'Заметки, таймер и напоминания'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabWeather" Style="{StaticResource TabBtn}" Content="sun.max" Tag="4" ToolTip="{loc:T 'Погода'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabControl" Style="{StaticResource TabBtn}" Content="slider.horizontal.2" Tag="5" ToolTip="{loc:T 'Управление'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSearch" Style="{StaticResource TabBtn}" Content="magnifyingglass" Tag="6" ToolTip="{loc:T 'Поиск'}" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSettings" Style="{StaticResource TabBtn}" Content="gearshape" Tag="7" ToolTip="{loc:T 'Настройки'}" Checked="Tab_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PinButton" Style="{StaticResource IconBtn}" Content="pin" ToolTip="{loc:T 'Закрепить открытым'}" Click="Pin_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- HOME -->
                    <Grid x:Name="HomeView" Margin="14,4,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="16" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ArtBorder" Width="68" Height="68" CornerRadius="16" Background="{StaticResource Surface2}">
                                            <local:Icon x:Name="ArtFallback" Style="{StaticResource Glyph}" Kind="music.note" Size="24" Foreground="{StaticResource SubBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T 'МУЗЫКА'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="MediaTitle" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MediaArtist" Foreground="{StaticResource SubBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PosText" Foreground="{StaticResource SubBrush}" FontSize="10" VerticalAlignment="Center" Width="32"/>
                                        <Grid Grid.Column="1" Height="3" VerticalAlignment="Center">
                                            <Border x:Name="ProgressTrack" Background="#26FFFFFF" CornerRadius="2"/>
                                            <Border x:Name="ProgressFill" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                        <TextBlock x:Name="DurText" Grid.Column="2" Foreground="{StaticResource SubBrush}" FontSize="10" VerticalAlignment="Center" Width="32" TextAlignment="Right"/>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="PrevButton" Style="{StaticResource TransportBtn}" Content="backward.fill" Click="Prev_Click"/>
                                        <Button x:Name="PlayButton" Style="{StaticResource PlayBtn}" Content="play.fill" Click="Play_Click"/>
                                        <Button x:Name="NextButton" Style="{StaticResource TransportBtn}" Content="forward.fill" Click="Next_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <UniformGrid Grid.Column="1" Columns="3" Rows="2" Margin="6,0,0,0">
                                <Button Style="{StaticResource Tile}" Tag="area" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="crop" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Область'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Tag="full" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="arrows.expand" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Весь экран'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Tag="ocr" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="text.viewfinder" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Текст с экрана'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Tag="picker" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="eyedropper" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Пипетка'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Tag="plain" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="textformat" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Чистый текст'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Tile}" Tag="folder" Click="Action_Click">
                                    <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="folder" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Скриншоты'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2,12,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:Icon x:Name="VolGlyph" Style="{StaticResource Glyph}" Kind="speaker.wave.2" Foreground="{StaticResource SubBrush}" Margin="0,0,10,0"/>
                            <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource VolSlider}" ValueChanged="VolSlider_ValueChanged"/>
                            <TextBlock x:Name="VolText" Grid.Column="2" Foreground="{StaticResource SubBrush}" FontSize="12" Width="30" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolDevice" Grid.Column="3" Foreground="{StaticResource SubBrush}" FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="6" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel x:Name="ShortcutsPanel" Orientation="Horizontal"/>
                                <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource SubBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- CLIPBOARD -->
                    <Grid x:Name="ClipView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipSearch" Style="{StaticResource InputBox}" Tag="{loc:T 'Поиск по буферу'}" TextChanged="ClipSearch_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="trash" Width="40" Height="40" Margin="6,0,0,0" ToolTip="{loc:T 'Очистить (закреплённые остаются)'}" Click="ClipClear_Click"/>
                        </Grid>
                        <ListBox x:Name="ClipList" Grid.Row="1" Style="{StaticResource CardList}" Margin="0,10,0,0" ItemTemplate="{StaticResource ClipRowTemplate}"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=ClipEmpty}">
                            <local:Icon Style="{StaticResource EmptyGlyph}" Kind="clipboard"/>
                            <TextBlock x:Name="ClipEmpty" Text="{loc:T 'Здесь появится всё, что вы копируете'}" Foreground="{StaticResource SubBrush}" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{loc:T 'Клик — вставить · Shift+клик — только копировать'}" Foreground="{StaticResource SubBrush}" FontSize="11" Margin="2,8,0,0"/>
                    </Grid>

                    <!-- INBOX: Windows notifications -->
                    <Grid x:Name="InboxView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,0,6">
                            <TextBlock Text="{loc:T 'Уведомления Windows'}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconBtn}" Content="trash" HorizontalAlignment="Right" Width="30" Height="28" ToolTip="{loc:T 'Очистить список (в Windows уведомления остаются)'}" Click="InboxClear_Click"/>
                        </Grid>
                        <ListBox x:Name="InboxList" Grid.Row="1" Style="{StaticResource CardList}" ItemTemplate="{StaticResource InboxRowTemplate}"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=InboxEmpty}">
                            <local:Icon Style="{StaticResource EmptyGlyph}" Kind="bell"/>
                            <TextBlock x:Name="InboxEmpty" Foreground="{StaticResource SubBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                        </StackPanel>
                    </Grid>

                    <!-- NOTES, TIMER, REMINDERS -->
                    <Grid x:Name="NotesView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="plus" Width="28" Height="28" ToolTip="{loc:T 'Новая заметка'}" Click="NoteNew_Click"/>
                                <ListBox x:Name="NotesList" Style="{StaticResource ChipList}" ItemTemplate="{StaticResource NoteRowTemplate}" SelectionChanged="NotesList_SelectionChanged"/>
                            </DockPanel>
                            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="12,10">
                                <Grid>
                                    <RichTextBox x:Name="NoteEditor" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="White" SelectionBrush="{DynamicResource AccentBrush}" FontSize="13" AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Hidden" Padding="0"
                                                 TextChanged="NoteEditor_TextChanged" PreviewKeyDown="NoteEditor_PreviewKeyDown"
                                                 PreviewMouseLeftButtonUp="NoteEditor_PreviewMouseLeftButtonUp">
                                        <RichTextBox.Resources>
                                            <Style TargetType="Paragraph">
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                            </Style>
                                        </RichTextBox.Resources>
                                    </RichTextBox>
                                    <TextBlock x:Name="NotePlaceholder" Text="{loc:T 'Начните писать…'}" Foreground="#59FFFFFF" FontSize="13" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                                    <TextBlock x:Name="NotesEmpty" Text="{loc:T 'Нажмите + и создайте заметку'}" Foreground="{StaticResource SubBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource Surface}" CornerRadius="18" Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FmtBtn}" Content="bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=NoteEditor}" ToolTip="{loc:T 'Жирный'}"/>
                                    <Button Style="{StaticResource FmtBtn}" Content="italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=NoteEditor}" ToolTip="{loc:T 'Курсив'}"/>
                                    <Button Style="{StaticResource FmtBtn}" ToolTip="{loc:T 'Зачёркнутый'}" Click="NoteStrike_Click">
                                        <TextBlock Text="S" FontFamily="Segoe UI" FontWeight="SemiBold" TextDecorations="Strikethrough"/>
                                    </Button>
                                    <Button Style="{StaticResource FmtBtn}" Content="eraser" ToolTip="{loc:T 'Убрать форматирование'}" Click="NoteClearFormat_Click"/>
                                    <Border Width="1" Margin="4,6" Background="#26FFFFFF"/>
                                    <Button Style="{StaticResource FmtBtn}" Content="list.bullet" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=NoteEditor}" ToolTip="{loc:T 'Маркированный список'}"/>
                                    <Button Style="{StaticResource FmtBtn}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=NoteEditor}" ToolTip="{loc:T 'Нумерованный список'}">
                                        <TextBlock Text="1." FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource FmtBtn}" Content="checkmark.square" ToolTip="{loc:T 'Задачи с галочками'}" Click="NoteChecklist_Click"/>
                                    <Border Width="1" Margin="4,6" Background="#26FFFFFF"/>
                                    <Button Style="{StaticResource FmtBtn}" Content="bell" ToolTip="{loc:T 'Напомнить об этой заметке'}" Click="NoteRemind_Click"/>
                                    <Button Style="{StaticResource FmtBtn}" Content="doc.on.doc" ToolTip="{loc:T 'Скопировать заметку'}" Click="NoteCopy_Click"/>
                                    <Button Style="{StaticResource FmtBtn}" Content="trash" ToolTip="{loc:T 'Удалить заметку'}" Click="NoteDelete_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="78" Height="78">
                                            <Ellipse Stroke="#26FFFFFF" StrokeThickness="6" Margin="3"/>
                                            <Path x:Name="TimerArc" Stroke="{StaticResource TimerBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <TextBlock x:Name="TimerText" Text="5:00" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button x:Name="TimerStart" Style="{StaticResource StartBtn}" Click="TimerStart_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Icon x:Name="TimerStartGlyph" Style="{StaticResource Glyph}" Kind="play.fill" Foreground="#1A1100" Size="11"/>
                                                    <TextBlock x:Name="TimerStartLabel" Text="{loc:T 'Старт'}" Foreground="#1A1100" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Tile}" Background="{StaticResource Surface2}" Margin="0,6,0,0" Height="28" Click="TimerSecondary_Click">
                                                <TextBlock x:Name="TimerSecondaryLabel" Text="{loc:T 'Своё время'}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="PresetRow" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource PresetBtn}" Content="5" Tag="5" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PresetBtn}" Content="10" Tag="10" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PresetBtn}" Content="15" Tag="15" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PresetBtn}" Content="25" Tag="25" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PresetBtn}" Content="45" Tag="45" Click="TimerPreset_Click"/>
                                        <TextBlock Text="{loc:T 'мин'}" Foreground="{StaticResource SubBrush}" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox x:Name="TimerCustom" Style="{StaticResource PlainInput}" Tag="{loc:T 'Минут и Enter'}" Margin="0,8,0,0" Visibility="Collapsed" KeyDown="TimerCustom_KeyDown"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="12" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="bell" Size="12" Foreground="{StaticResource SubBrush}"/>
                                        <TextBlock Text="{loc:T 'Напоминания'}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ListBox x:Name="ReminderList" Grid.Row="1" Style="{StaticResource PlainList}" ItemTemplate="{StaticResource ReminderRowTemplate}" Margin="0,4,0,4"/>
                                    <TextBlock x:Name="ReminderEmpty" Grid.Row="1" Foreground="{StaticResource SubBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4"
                                               Text="{loc:T 'Напишите ниже, о чём и когда: «позвонить маме завтра в 9», «таблетки каждый день в 23:00», «через 20 минут выключить плиту».'}"/>
                                    <TextBox x:Name="ReminderBox" Grid.Row="2" Style="{StaticResource PlainInput}" Tag="{loc:T 'Позвонить маме завтра в 9'}" KeyDown="ReminderBox_KeyDown"/>
                                    <TextBlock x:Name="ReminderHint" Grid.Row="3" Foreground="#FF7A8C" FontSize="10" TextWrapping="Wrap" Margin="2,4,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- WEATHER -->
                    <Grid x:Name="WeatherView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="WxCard" CornerRadius="{StaticResource CardRadius}" Padding="16,12" Margin="0,0,8,0" Background="#2F6FD0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="location" Size="12" Foreground="White"/>
                                        <TextBlock x:Name="WxCity" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconBtn}" Content="arrow.clockwise" Foreground="#CCFFFFFF" HorizontalAlignment="Right" Width="26" Height="26" FontSize="12" ToolTip="{loc:T 'Обновить'}" Click="WeatherRefresh_Click"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <ContentControl x:Name="WxIcon" Width="40" Height="40" VerticalAlignment="Center" Focusable="False"/>
                                    <TextBlock x:Name="WxTemp" Foreground="White" FontSize="54" FontWeight="Light" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="WxDesc" Grid.Row="2" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WxFeels" Grid.Row="3" Foreground="#D9FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <UniformGrid Grid.Row="5" Columns="3" Margin="0,8,0,0">
                                    <Border Background="#29FFFFFF" CornerRadius="12" Padding="6,6" Margin="0,0,3,0">
                                        <StackPanel>
                                            <TextBlock x:Name="WxWindCaption" Text="{loc:T 'ВЕТЕР'}" Foreground="#B3FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="WxWind" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#29FFFFFF" CornerRadius="12" Padding="6,6" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T 'ВЛАЖН.'}" Foreground="#B3FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="WxHum" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#29FFFFFF" CornerRadius="12" Padding="6,6" Margin="3,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T 'ОСАДКИ'}" Foreground="#B3FFFFFF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="WxPrecip" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock x:Name="WxSun" Grid.Row="6" Foreground="#D9FFFFFF" FontSize="11" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="6,10">
                                <UniformGrid x:Name="HourPanel" Columns="8"/>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,10" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel x:Name="DayPanel" VerticalAlignment="Top"/>
                                    <TextBlock Text="{loc:T 'Данные Open-Meteo'}" Foreground="#59FFFFFF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- CONTROL CENTER -->
                    <Grid x:Name="ControlView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="74"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="2" Rows="2">
                            <Button Style="{StaticResource ControlTile}" Tag="wifi" Click="Tile_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="WifiIcon" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface2}" Effect="{StaticResource IconBadgeShadow}">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="wifi" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Wi-Fi" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WifiState" Foreground="{StaticResource SubBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ControlTile}" Tag="bluetooth" Click="Tile_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="BluetoothIcon" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface2}" Effect="{StaticResource IconBadgeShadow}">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="bluetooth" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BluetoothState" Foreground="{StaticResource SubBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ControlTile}" Tag="theme" Click="Tile_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="ThemeIcon" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface2}" Effect="{StaticResource IconBadgeShadow}">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="circle.lefthalf.filled" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T 'Тёмная тема'}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ThemeState" Foreground="{StaticResource SubBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ControlTile}" Tag="vpn" Click="Tile_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="VpnIcon" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface2}" Effect="{StaticResource IconBadgeShadow}">
                                        <local:Icon Style="{StaticResource Glyph}" Kind="lock.shield" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="VPN" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VpnState" Foreground="{StaticResource SubBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,4,0,0">
                            <Button Style="{StaticResource Tile}" Tag="lock" Click="Power_Click">
                                <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="lock" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Блокировка'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Tile}" Tag="sleep" Click="Power_Click">
                                <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="moon" HorizontalAlignment="Center"/><TextBlock Text="{loc:T 'Сон'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Tile}" Tag="restart" Click="Power_Click">
                                <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="arrow.clockwise" HorizontalAlignment="Center"/><TextBlock x:Name="RestartLabel" Text="{loc:T 'Перезагрузка'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Tile}" Tag="shutdown" Click="Power_Click">
                                <StackPanel><local:Icon Style="{StaticResource Glyph}" Kind="power" HorizontalAlignment="Center"/><TextBlock x:Name="ShutdownLabel" Text="{loc:T 'Выключение'}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- SEARCH -->
                    <Grid x:Name="SearchView" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="{loc:T 'Программы, файлы, вопрос к ИИ'}" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <ListBox x:Name="SearchList" Grid.Row="1" Style="{StaticResource CardList}" Margin="0,10,0,0" ItemTemplate="{StaticResource SearchRowTemplate}"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SearchList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <local:Icon Style="{StaticResource EmptyGlyph}" Kind="magnifyingglass"/>
                            <TextBlock Text="{loc:T 'Программы, файлы из индекса Windows, вопрос к ИИ или поиск в браузере'}" Foreground="{StaticResource SubBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{loc:T '↑↓ — выбор · Enter — открыть · Esc — закрыть'}" Foreground="{StaticResource SubBrush}" FontSize="11" Margin="2,8,0,0"/>
                    </Grid>

                    <!-- SETTINGS -->
                    <ScrollViewer x:Name="SettingsView" Margin="14,4,14,14" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel Margin="0,0,6,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'ЯЗЫК'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="LanguageRuButton" Style="{StaticResource PresetBtn}" Content="Русский" Tag="ru" Click="Language_Click"/>
                                        <Button x:Name="LanguageFrButton" Style="{StaticResource PresetBtn}" Content="Français" Tag="fr" Click="Language_Click"/>
                                        <Button x:Name="LanguageEnButton" Style="{StaticResource PresetBtn}" Content="English" Tag="en" Click="Language_Click"/>
                                    </WrapPanel>
                                    <TextBlock Text="{loc:T 'Язык изменится после перезапуска.'}" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'РЕЖИМ'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ModeStandardButton" Style="{StaticResource PresetBtn}" Content="{loc:T 'Стандартный'}" Tag="standard" Click="Mode_Click"/>
                                        <Button x:Name="ModeMinimalButton" Style="{StaticResource PresetBtn}" Content="{loc:T 'Минималистичный'}" Tag="minimal" Click="Mode_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:T 'Минималистичный: маленький кружок, при наведении открывается остров.'}" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'ОБНОВЛЕНИЯ'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="UpdateVersionText" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Проверять обновления автоматически'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="UpdateAutoButton" Grid.Column="1" Style="{StaticResource PresetBtn}" MinWidth="56" Margin="8,0,0,0" Click="UpdateAuto_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="UpdateCheckButton" Style="{StaticResource PresetBtn}" Content="{loc:T 'Проверить сейчас'}" Click="UpdateCheck_Click"/>
                                        <Button x:Name="UpdateInstallButton" Style="{StaticResource PresetBtn}" Visibility="Collapsed" Click="UpdateInstall_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'ПОГОДА'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Город'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SetCity" Grid.Column="1" Style="{StaticResource PlainInput}" Tag="{loc:T 'Например, Москва'}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Широта'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SetLatitude" Grid.Column="1" Style="{StaticResource PlainInput}" Tag="46.2022" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Долгота'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SetLongitude" Grid.Column="1" Style="{StaticResource PlainInput}" Tag="6.1457" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'ПОИСК И ИИ'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Поиск'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SetSearch" Grid.Column="1" Style="{StaticResource PlainInput}" Tag="{loc:T 'адрес с \{0\}'}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:T 'Спросить ИИ'}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBox x:Name="SetAsk" Grid.Column="1" Style="{StaticResource PlainInput}" Tag="{loc:T 'адрес с \{0\}'}" LostFocus="SettingsField_LostFocus" KeyDown="SettingsField_KeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'ОФОРМЛЕНИЕ'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:T 'Акцентный цвет'}" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="AccentPanel"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource CardRadius}" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'СИСТЕМА'}" Foreground="{StaticResource SubBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="SetPort" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PresetBtn}" Content="{loc:T 'Файл настроек'}" Margin="0,0,6,0" Click="OpenSettingsFile_Click"/>
                                        <Button Style="{StaticResource PresetBtn}" Content="{loc:T 'Папка с данными'}" Click="OpenDataFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="SetHint" Foreground="#FF7A8C" FontSize="11" TextWrapping="Wrap" Margin="4,0,0,8" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
